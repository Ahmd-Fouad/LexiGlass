// LexiGlass database schema.
// Default provider is SQLite for zero-setup local use.
// To use Supabase/PostgreSQL: change provider to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  name               String
  passwordHash       String
  createdAt          DateTime                   @default(now())
  flashcards         Flashcard[]
  grammarTopics      GrammarTopic[]
  quizSessions       QuizSession[]
  reviewLogs         ReviewLog[]
  generatedQuestions GeneratedGrammarQuestion[]
  grammarMistakes    GrammarMistake[]
  aiGenerationLogs   AIGenerationLog[]
}

// A flashcard is either a word or a phrase (kind field).
model Flashcard {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  text          String // the English word or phrase
  kind          String    @default("word") // "word" | "phrase"
  meaning       String // English meaning / definition
  translation   String? // Arabic translation
  example       String? // example sentence (should contain the word)
  pronunciation String? // pronunciation notes, e.g. /ˈwɜːrd/
  wordType      String? // noun | verb | adjective | adverb | phrase | idiom | other
  notes         String?
  tags          String    @default("") // comma-separated tags
  category      String?
  difficulty    String    @default("medium") // easy | medium | hard

  // Spaced repetition state
  easeFactor     Float     @default(2.5)
  intervalDays   Float     @default(0)
  dueDate        DateTime  @default(now())
  reviewCount    Int       @default(0)
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  lapses         Int       @default(0) // times answered "Again" / wrong
  lastReviewedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reviewLogs  ReviewLog[]
  quizAnswers QuizAnswer[]

  @@index([userId, dueDate])
}

model GrammarTopic {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  explanation    String
  examples       String       @default("") // one example per line
  commonMistakes String       @default("") // one mistake per line, format: "wrong => right"
  notes          String?
  tags           String       @default("")
  difficulty     String       @default("medium")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quizAnswers    QuizAnswer[]
  generatedQuestions GeneratedGrammarQuestion[]
  grammarMistakes    GrammarMistake[]

  @@index([userId])
}

// A grammar quiz question generated for one topic — either by an external
// AI provider or by the local rule-based generator. Never hard-deleted when
// answered: correct answers move it to `retired`/`mastered`, preserving
// history and analytics. `choices` holds the MCQ options (null for typed
// question types). `sourceHash` is a hash of the topic content it was made
// from, so regeneration is skipped while the topic is unchanged.
model GeneratedGrammarQuestion {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammarTopicId String
  grammarTopic   GrammarTopic @relation(fields: [grammarTopicId], references: [id], onDelete: Cascade)

  provider      String // gemini | groq | openrouter | cloudflare | huggingface | local
  model         String  @default("")
  sourceHash    String
  questionType  String // choose_correct | correct_mistake | find_mistake | fill_gap | rule_understanding | sentence_transformation
  question      String
  choices       Json? // string[] for MCQ types, null otherwise
  correctAnswer String
  explanation   String
  difficulty    String  @default("medium")
  source        String  @default("ai_generated") // ai_generated | local
  status        String  @default("active") // draft | approved | rejected | active | retired | mastered

  qualityScore   Float     @default(0)
  timesShown     Int       @default(0)
  timesCorrect   Int       @default(0)
  timesWrong     Int       @default(0)
  lastShownAt    DateTime?
  lastAnsweredAt DateTime?
  retiredAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  grammarMistakes GrammarMistake[]

  @@index([grammarTopicId, status])
  @@index([userId, grammarTopicId, status])
}

// A specific grammar question the user got wrong, kept for Mistake Bank /
// mistake-repair practice. Distinct from the generic QuizAnswer trail: this
// aggregates repeated failures of the same question (mistakeCount) and tracks
// resolution (active → practiced → resolved).
model GrammarMistake {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammarTopicId      String?
  grammarTopic        GrammarTopic?             @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  generatedQuestionId String?
  generatedQuestion   GeneratedGrammarQuestion? @relation(fields: [generatedQuestionId], references: [id], onDelete: SetNull)
  quizSessionId       String?
  quizAnswerId        String?

  question      String
  userAnswer    String
  correctAnswer String
  explanation   String   @default("")
  questionType  String   @default("")
  mistakeCount  Int      @default(1)
  lastMistakeAt DateTime @default(now())
  status        String   @default("active") // active | practiced | resolved
  practicedAt   DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, grammarTopicId])
}

// One row per AI generation attempt (per provider). No secrets stored.
model AIGenerationLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammarTopicId String?
  provider       String
  model          String   @default("")
  status         String // success | failed | skipped
  errorMessage   String?
  generatedCount Int      @default(0)
  validCount     Int      @default(0)
  rejectedCount  Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model QuizSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // "vocab" | "grammar" | "review"
  totalQuestions Int          @default(0)
  correctCount   Int          @default(0)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  answers        QuizAnswer[]

  @@index([userId, startedAt])
}

model QuizAnswer {
  id             String        @id @default(cuid())
  sessionId      String
  session        QuizSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  flashcardId    String?
  flashcard      Flashcard?    @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  grammarTopicId String?
  grammarTopic   GrammarTopic? @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  questionType   String // mcq_meaning | mcq_word | fill_blank | true_false | mcq | choose_correct | find_mistake | correct_sentence
  question       String
  correctAnswer  String
  userAnswer     String
  isCorrect      Boolean
  createdAt      DateTime      @default(now())
}

// Cached external dictionary lookups (dictionaryapi.dev, FreeDictionaryAPI,
// Datamuse, Tatoeba) so the same term never hits the free APIs twice.
// `data` holds the normalized lookup result as a JSON string (kept as String
// for SQLite compatibility). Definition and example lookups are cached
// separately via `type`.
model DictionaryCache {
  id             String   @id @default(cuid())
  term           String // original display text as typed
  normalizedTerm String // lowercased / trimmed lookup key
  type           String // "definition" | "example"
  source         String // primary source that produced the data
  data           String // JSON payload (normalized suggestions)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([normalizedTerm, type])
}

// One row per SRS review of a flashcard (from review mode or a vocab quiz).
model ReviewLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId    String
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  rating         String // again | hard | good | easy
  wasCorrect     Boolean
  intervalBefore Float
  intervalAfter  Float
  reviewedAt     DateTime  @default(now())

  @@index([userId, reviewedAt])
}
