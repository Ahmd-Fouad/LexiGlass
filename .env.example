# Copy this file to .env and fill in the values.

# PostgreSQL (matches provider = "postgresql" in prisma/schema.prisma).
# Supabase/Neon/Vercel Postgres connection string:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Canonical browser origin used by the mutation Origin/Referer gate.
APP_ORIGIN="http://localhost:3000"

# Optional non-secret rate-limit overrides; defaults live in lib/rate-limit.ts.
# RATE_LIMIT_LOGIN_MAX="8"
# RATE_LIMIT_REGISTER_MAX="5"
# RATE_LIMIT_DICTIONARY_MAX="60"
# RATE_LIMIT_PROVIDER_TEST_MAX="5"
# RATE_LIMIT_GRAMMAR_GENERATE_MAX="10"
# RATE_LIMIT_GRAMMAR_TOP_UP_MAX="20"
# RATE_LIMIT_QUIZ_START_MAX="20"
# RATE_LIMIT_QUIZ_ANSWER_MAX="120"
# RATE_LIMIT_REVIEW_ONLINE_MAX="120"
# RATE_LIMIT_REVIEW_SYNC_MAX="20"
# RATE_LIMIT_WRITING_ATTEMPT_MAX="30"

# ---------------------------------------------------------------------------
# Adaptive AI grammar question pool (all optional).
# The app works with none of these set: grammar quizzes fall back to the local
# rule-based generator, your saved examples/mistakes, and the built-in bank.
# All provider calls are server-side only; keys are never sent to the client
# and never stored in the database.
# ---------------------------------------------------------------------------

# Master switch for calling external AI providers. When "false" (or unset),
# only the offline local generator runs. Set to "true" once you add a key.
AI_QUIZ_ENABLED="false"

# Preferred provider (moved to the front of the fallback order) and the full
# order to try. "local" is always appended last as the guaranteed fallback.
AI_QUIZ_PRIMARY_PROVIDER="gemini"
AI_QUIZ_PROVIDER_ORDER="gemini,groq,openrouter,cloudflare,huggingface,local"

# Provider API keys — add at least one to enable AI generation.
# Google Gemini (free tier):        https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Groq (free tier):                 https://console.groq.com/keys
GROQ_API_KEY=""
# OpenRouter (has free models):     https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Cloudflare Workers AI:            https://dash.cloudflare.com/  (Account ID + API token)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Hugging Face Inference (optional): https://huggingface.co/settings/tokens
HF_TOKEN=""

# Optional per-provider model overrides (sensible free defaults are built in):
# GEMINI_MODEL="gemini-1.5-flash"
# GROQ_MODEL="llama-3.1-8b-instant"
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"
# HF_MODEL="mistralai/Mistral-7B-Instruct-v0.3"
